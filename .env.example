# ---------------------------------------------------------------------------
# La Guérite Cannes reservation monitor — copy this file to `.env` and edit.
# NEVER commit the real `.env` (it is already in .gitignore).
# ---------------------------------------------------------------------------

# --- What to hunt for ------------------------------------------------------
RESTAURANT=La Guerite Cannes
DATE=2026-09-03
PARTY_SIZE=6
EARLIEST_TIME=14:00
LATEST_TIME=16:00

# --- How often to look -----------------------------------------------------
# A random delay in this range is used between checks. Minimum allowed is 30s;
# please keep it at 60s or more to stay polite to the booking site.
MIN_CHECK_INTERVAL_SECONDS=45
MAX_CHECK_INTERVAL_SECONDS=120

# Optional day/night pacing, in the VENUE's timezone. Blank = one cadence
# around the clock (the right default for a venue with international guests:
# 01:00 in Cannes is 19:00 in New York, so there is no dead hour).
# Only enable this for a venue whose guests are genuinely local.
ACTIVE_HOURS_START=
ACTIVE_HOURS_END=
OFFPEAK_MIN_CHECK_INTERVAL_SECONDS=300
OFFPEAK_MAX_CHECK_INTERVAL_SECONDS=900

# ---------------------------------------------------------------------------
# NOTIFICATIONS — configure AT LEAST ONE of the three blocks below.
# If you leave NOTIFY_CHANNELS empty, every fully-configured block is used.
# ---------------------------------------------------------------------------
NOTIFY_CHANNELS=telegram

# --- 1. Telegram (free, instant, no domain or DNS needed) ------------------
# Step 1: open Telegram, message @BotFather, send /newbot, copy the token.
# Step 2: find your new bot, press START, send it any message.
# Step 3: run  python -m laguerite.monitor --telegram-setup
#         ...which prints the TELEGRAM_CHAT_ID to paste below.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# --- 2. Email via Resend ---------------------------------------------------
# Get a key at https://resend.com -> API Keys, then set NOTIFY_CHANNELS=email.
# Note: the shared onboarding@resend.dev sender can ONLY deliver to the address
# your Resend account is registered with. To email anywhere else, verify a
# domain and use e.g. NOTIFY_EMAIL_FROM=alerts@yourdomain.com
RESEND_API_KEY=
NOTIFY_EMAIL_TO=
NOTIFY_EMAIL_FROM=onboarding@resend.dev

# --- 3. Pushover -----------------------------------------------------------
PUSHOVER_TOKEN=
PUSHOVER_USER_KEY=

# ---------------------------------------------------------------------------
# Advanced — the defaults are fine.
# ---------------------------------------------------------------------------

# Stop the monitor as soon as it has alerted you once.
STOP_AFTER_FIRST_NOTIFICATION=false

# SevenRooms venue slug, from https://www.sevenrooms.com/reservations/<slug>
SEVENROOMS_VENUE_SLUG=lagueritecannes
VENUE_TIMEZONE=Europe/Paris

# Which SevenRooms slot types count as a real, bookable table.
# "book" = confirmable table. "request" = you may only ASK for a table, which
# is NOT a confirmed reservation, so it is deliberately excluded.
# Set to `book,request` if you also want alerts for request-only slots.
BOOKABLE_SLOT_TYPES=book

# Load the real booking page in headless Chromium when the direct API fails.
# Requires: pip install playwright && python -m playwright install chromium
USE_PLAYWRIGHT_FALLBACK=false
PLAYWRIGHT_TIMEOUT_MS=45000

REQUEST_TIMEOUT_SECONDS=30
MAX_ATTEMPTS_PER_CHECK=3

# Email you when availability cannot be determined (site changed / long outage).
ERROR_NOTIFICATION_AFTER_FAILURES=5
ERROR_NOTIFICATION_COOLDOWN_SECONDS=3600

# Periodic "still watching, nothing yet" message, so silence never leaves you
# wondering whether the monitor died. Set to 0 to disable.
HEARTBEAT_HOURS=24

STATE_FILE=state/state.json
LOG_FILE=logs/monitor.log
LOG_LEVEL=INFO

# If set, serves a JSON status page (needed for Render "Web Service" deploys).
# Most hosts inject PORT automatically; leave blank for a background worker.
# HEALTH_PORT=8080
